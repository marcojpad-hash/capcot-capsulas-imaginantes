Dialogue: 0,0:00:00.30,0:00:01.22,Sub,,0,0,0,,Una nave europea
Dialogue: 0,0:00:01.23,0:00:01.72,Sub,,0,0,0,,llegó a un
Dialogue: 0,0:00:01.73,0:00:02.55,Sub,,0,0,0,,asteroide que ya
Dialogue: 0,0:00:02.56,0:00:03.56,Sub,,0,0,0,,empujamos.
Dialogue: 0,0:00:03.78,0:00:04.49,Sub,,0,0,0,,Y encontró un
Dialogue: 0,0:00:04.50,0:00:05.19,Sub,,0,0,0,,lado que nadie
Dialogue: 0,0:00:05.20,0:00:05.90,Sub,,0,0,0,,había visto de
Dialogue: 0,0:00:05.91,0:00:06.65,Sub,,0,0,0,,cerca.
Dialogue: 0,0:00:07.13,0:00:08.47,Sub,,0,0,0,,En 2022,
Dialogue: 0,0:00:08.48,0:00:09.33,Sub,,0,0,0,,la NASA estrelló
Dialogue: 0,0:00:09.34,0:00:10.29,Sub,,0,0,0,,su nave DART,
Dialogue: 0,0:00:10.30,0:00:11.29,Sub,,0,0,0,,de quinientos ochenta
Dialogue: 0,0:00:11.30,0:00:11.92,Sub,,0,0,0,,kilos,
Dialogue: 0,0:00:11.93,0:00:13.12,Sub,,0,0,0,,contra Dimorphos,
Dialogue: 0,0:00:13.13,0:00:14.42,Sub,,0,0,0,,un asteroide pequeño,
Dialogue: 0,0:00:14.43,0:00:15.45,Sub,,0,0,0,,a seis kilómetros
Dialogue: 0,0:00:15.46,0:00:16.42,Sub,,0,0,0,,por segundo.
Dialogue: 0,0:00:16.64,0:00:17.90,Sub,,0,0,0,,Fue a propósito:
Dialogue: 0,0:00:18.05,0:00:18.82,Sub,,0,0,0,,querían saber si
Dialogue: 0,0:00:18.83,0:00:19.61,Sub,,0,0,0,,se puede desviar
Dialogue: 0,0:00:19.62,0:00:20.70,Sub,,0,0,0,,una roca así.
Dialogue: 0,0:00:21.20,0:00:21.91,Sub,,0,0,0,,Y funcionó de
Dialogue: 0,0:00:21.92,0:00:22.63,Sub,,0,0,0,,más.
Dialogue: 0,0:00:22.85,0:00:23.88,Sub,,0,0,0,,Dimorphos da vueltas
Dialogue: 0,0:00:23.89,0:00:24.75,Sub,,0,0,0,,alrededor de otro
Dialogue: 0,0:00:24.76,0:00:25.50,Sub,,0,0,0,,asteroide,
Dialogue: 0,0:00:25.51,0:00:26.18,Sub,,0,0,0,,Didymos,
Dialogue: 0,0:00:26.19,0:00:26.71,Sub,,0,0,0,,y su vuelta
Dialogue: 0,0:00:26.72,0:00:27.49,Sub,,0,0,0,,se acortó treinta
Dialogue: 0,0:00:27.50,0:00:28.56,Sub,,0,0,0,,y tres minutos,
Dialogue: 0,0:00:28.57,0:00:29.19,Sub,,0,0,0,,mucho más de
Dialogue: 0,0:00:29.20,0:00:30.12,Sub,,0,0,0,,lo previsto.
Dialogue: 0,0:00:30.60,0:00:31.71,Sub,,0,0,0,,Ahora llegó Hera,
Dialogue: 0,0:00:31.72,0:00:32.30,Sub,,0,0,0,,de la Agencia
Dialogue: 0,0:00:32.31,0:00:33.56,Sub,,0,0,0,,Espacial Europea,
Dialogue: 0,0:00:33.57,0:00:34.33,Sub,,0,0,0,,tras dos años
Dialogue: 0,0:00:34.34,0:00:35.14,Sub,,0,0,0,,de viaje.
Dialogue: 0,0:00:35.36,0:00:36.73,Sub,,0,0,0,,Desde sesenta kilómetros
Dialogue: 0,0:00:36.74,0:00:37.51,Sub,,0,0,0,,tomó su primera
Dialogue: 0,0:00:37.52,0:00:38.38,Sub,,0,0,0,,foto cercana de
Dialogue: 0,0:00:38.39,0:00:39.21,Sub,,0,0,0,,los dos.
Dialogue: 0,0:00:39.70,0:00:40.63,Sub,,0,0,0,,Didymos mide unos
Dialogue: 0,0:00:40.64,0:00:42.43,Sub,,0,0,0,,setecientos ochenta metros.
Dialogue: 0,0:00:42.65,0:00:43.49,Sub,,0,0,0,,Dimorphos,
Dialogue: 0,0:00:43.50,0:00:44.33,Sub,,0,0,0,,ciento cincuenta y
Dialogue: 0,0:00:44.34,0:00:44.82,Sub,,0,0,0,,uno,
Dialogue: 0,0:00:44.83,0:00:45.71,Sub,,0,0,0,,quedó casi todo
Dialogue: 0,0:00:45.72,0:00:46.54,Sub,,0,0,0,,en sombra.
Dialogue: 0,0:00:47.04,0:00:47.89,Sub,,0,0,0,,La sorpresa está
Dialogue: 0,0:00:47.90,0:00:48.81,Sub,,0,0,0,,en Didymos:
Dialogue: 0,0:00:48.96,0:00:49.51,Sub,,0,0,0,,es el lado
Dialogue: 0,0:00:49.52,0:00:50.26,Sub,,0,0,0,,que DART nunca
Dialogue: 0,0:00:50.27,0:00:50.85,Sub,,0,0,0,,vio.
Dialogue: 0,0:00:51.07,0:00:51.78,Sub,,0,0,0,,Tiene la misma
Dialogue: 0,0:00:51.79,0:00:52.31,Sub,,0,0,0,,cresta en el
Dialogue: 0,0:00:52.32,0:00:52.95,Sub,,0,0,0,,ecuador,
Dialogue: 0,0:00:52.96,0:00:53.59,Sub,,0,0,0,,una especie de
Dialogue: 0,0:00:53.60,0:00:54.78,Sub,,0,0,0,,cinturón de roca,
Dialogue: 0,0:00:54.79,0:00:55.72,Sub,,0,0,0,,pero también piedras
Dialogue: 0,0:00:55.73,0:00:56.41,Sub,,0,0,0,,sueltas,
Dialogue: 0,0:00:56.42,0:00:57.83,Sub,,0,0,0,,cráteres y surcos.
Dialogue: 0,0:00:58.32,0:00:59.57,Sub,,0,0,0,,¿Vienen del choque?
Dialogue: 0,0:00:59.82,0:01:00.89,Sub,,0,0,0,,Los científicos creen
Dialogue: 0,0:01:00.90,0:01:01.48,Sub,,0,0,0,,que parte del
Dialogue: 0,0:01:01.49,0:01:02.40,Sub,,0,0,0,,material que salió
Dialogue: 0,0:01:02.41,0:01:03.39,Sub,,0,0,0,,disparado cruzó el
Dialogue: 0,0:01:03.40,0:01:04.50,Sub,,0,0,0,,kilómetro que separa
Dialogue: 0,0:01:04.51,0:01:05.39,Sub,,0,0,0,,a los dos.
Dialogue: 0,0:01:05.61,0:01:06.31,Sub,,0,0,0,,Todavía no lo
Dialogue: 0,0:01:06.32,0:01:07.06,Sub,,0,0,0,,saben.
Dialogue: 0,0:01:07.28,0:01:08.34,Sub,,0,0,0,,Las fotos detalladas
Dialogue: 0,0:01:08.35,0:01:09.16,Sub,,0,0,0,,salen el 25
Dialogue: 0,0:01:09.17,0:01:10.26,Sub,,0,0,0,,de noviembre.
Dialogue: 0,0:01:10.75,0:01:11.67,Sub,,0,0,0,,Movimos una roca
Dialogue: 0,0:01:11.68,0:01:12.58,Sub,,0,0,0,,en el espacio,
Dialogue: 0,0:01:12.59,0:01:13.62,Sub,,0,0,0,,y quizá salpicamos
Dialogue: 0,0:01:13.63,0:01:14.61,Sub,,0,0,0,,a su vecina.
Dialogue: 0,0:01:14.83,0:01:15.48,Sub,,0,0,0,,¿Qué más cambió
Dialogue: 0,0:01:15.49,0:01:16.15,Sub,,0,0,0,,ese golpe que
Dialogue: 0,0:01:16.16,0:01:17.51,Sub,,0,0,0,,todavía no vemos?
Dialogue: 0,0:01:17.76,0:01:18.60,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:18.61,0:01:19.77,Sub,,0,0,0,,y ociosidades.
