Dialogue: 0,0:00:00.25,0:00:01.77,Sub,,0,0,0,,El sarampión volvió
Dialogue: 0,0:00:01.78,0:00:03.30,Sub,,0,0,0,,a México después
Dialogue: 0,0:00:03.31,0:00:04.83,Sub,,0,0,0,,de treinta años.
Dialogue: 0,0:00:04.84,0:00:06.36,Sub,,0,0,0,,Desde febrero de
Dialogue: 0,0:00:06.37,0:00:07.89,Sub,,0,0,0,,2025 se han
Dialogue: 0,0:00:07.90,0:00:09.43,Sub,,0,0,0,,confirmado más de
Dialogue: 0,0:00:09.44,0:00:10.96,Sub,,0,0,0,,veinte mil casos
Dialogue: 0,0:00:10.97,0:00:12.49,Sub,,0,0,0,,y cincuenta muertes,
Dialogue: 0,0:00:12.50,0:00:14.02,Sub,,0,0,0,,según la Secretaría
Dialogue: 0,0:00:14.03,0:00:15.35,Sub,,0,0,0,,de Salud.
Dialogue: 0,0:00:15.60,0:00:16.98,Sub,,0,0,0,,México había cortado
Dialogue: 0,0:00:16.99,0:00:18.37,Sub,,0,0,0,,la transmisión en
Dialogue: 0,0:00:18.38,0:00:18.83,Sub,,0,0,0,,1996,
Dialogue: 0,0:00:18.84,0:00:20.22,Sub,,0,0,0,,así que el
Dialogue: 0,0:00:20.23,0:00:21.61,Sub,,0,0,0,,virus no circulaba
Dialogue: 0,0:00:21.62,0:00:22.07,Sub,,0,0,0,,aquí,
Dialogue: 0,0:00:22.08,0:00:23.46,Sub,,0,0,0,,pero la protección
Dialogue: 0,0:00:23.47,0:00:24.84,Sub,,0,0,0,,se fue cayendo:
Dialogue: 0,0:00:24.85,0:00:26.23,Sub,,0,0,0,,la primera dosis
Dialogue: 0,0:00:26.24,0:00:27.62,Sub,,0,0,0,,pasó de más
Dialogue: 0,0:00:27.63,0:00:29.01,Sub,,0,0,0,,del noventa y
Dialogue: 0,0:00:29.02,0:00:30.40,Sub,,0,0,0,,cinco por ciento
Dialogue: 0,0:00:30.41,0:00:31.79,Sub,,0,0,0,,a ochenta y
Dialogue: 0,0:00:31.80,0:00:32.25,Sub,,0,0,0,,ocho,
Dialogue: 0,0:00:32.26,0:00:33.64,Sub,,0,0,0,,y la segunda
Dialogue: 0,0:00:33.65,0:00:35.02,Sub,,0,0,0,,se quedó en
Dialogue: 0,0:00:35.03,0:00:36.72,Sub,,0,0,0,,sesenta y nueve.
Dialogue: 0,0:00:36.97,0:00:38.31,Sub,,0,0,0,,Y cuando la
Dialogue: 0,0:00:38.32,0:00:39.21,Sub,,0,0,0,,protección baja,
Dialogue: 0,0:00:39.22,0:00:40.56,Sub,,0,0,0,,el virus encuentra
Dialogue: 0,0:00:40.57,0:00:41.91,Sub,,0,0,0,,por dónde entrar,
Dialogue: 0,0:00:41.92,0:00:43.26,Sub,,0,0,0,,porque se transmite
Dialogue: 0,0:00:43.27,0:00:44.61,Sub,,0,0,0,,por el aire
Dialogue: 0,0:00:44.62,0:00:45.96,Sub,,0,0,0,,y basta con
Dialogue: 0,0:00:45.97,0:00:47.31,Sub,,0,0,0,,estar cerca de
Dialogue: 0,0:00:47.32,0:00:48.51,Sub,,0,0,0,,alguien enfermo.
Dialogue: 0,0:00:48.76,0:00:49.97,Sub,,0,0,0,,Por eso los
Dialogue: 0,0:00:49.98,0:00:51.20,Sub,,0,0,0,,más afectados son
Dialogue: 0,0:00:51.21,0:00:52.42,Sub,,0,0,0,,los más chicos:
Dialogue: 0,0:00:52.43,0:00:53.64,Sub,,0,0,0,,casi tres mil
Dialogue: 0,0:00:53.65,0:00:54.86,Sub,,0,0,0,,casos tienen entre
Dialogue: 0,0:00:54.87,0:00:56.08,Sub,,0,0,0,,uno y cuatro
Dialogue: 0,0:00:56.09,0:00:56.48,Sub,,0,0,0,,años,
Dialogue: 0,0:00:56.49,0:00:57.70,Sub,,0,0,0,,y la incidencia
Dialogue: 0,0:00:57.71,0:00:58.92,Sub,,0,0,0,,más alta está
Dialogue: 0,0:00:58.93,0:01:00.14,Sub,,0,0,0,,en los menores
Dialogue: 0,0:01:00.15,0:01:01.67,Sub,,0,0,0,,de un año.
Dialogue: 0,0:01:01.92,0:01:03.31,Sub,,0,0,0,,Jalisco lleva más
Dialogue: 0,0:01:03.32,0:01:04.70,Sub,,0,0,0,,de ocho mil,
Dialogue: 0,0:01:04.71,0:01:06.10,Sub,,0,0,0,,y le siguen
Dialogue: 0,0:01:06.11,0:01:06.57,Sub,,0,0,0,,Chihuahua,
Dialogue: 0,0:01:06.58,0:01:07.96,Sub,,0,0,0,,Chiapas y la
Dialogue: 0,0:01:07.97,0:01:09.36,Sub,,0,0,0,,Ciudad de México.
Dialogue: 0,0:01:09.37,0:01:10.75,Sub,,0,0,0,,En 1989 hubo
Dialogue: 0,0:01:10.76,0:01:12.15,Sub,,0,0,0,,casi noventa mil
Dialogue: 0,0:01:12.16,0:01:12.61,Sub,,0,0,0,,casos,
Dialogue: 0,0:01:12.62,0:01:14.01,Sub,,0,0,0,,así que no
Dialogue: 0,0:01:14.02,0:01:14.94,Sub,,0,0,0,,es nuevo:
Dialogue: 0,0:01:14.95,0:01:16.34,Sub,,0,0,0,,es el regreso
Dialogue: 0,0:01:16.35,0:01:17.73,Sub,,0,0,0,,de algo que
Dialogue: 0,0:01:17.74,0:01:19.44,Sub,,0,0,0,,ya estaba controlado.
Dialogue: 0,0:01:19.69,0:01:20.81,Sub,,0,0,0,,Y lo que
Dialogue: 0,0:01:20.82,0:01:21.95,Sub,,0,0,0,,lo trae de
Dialogue: 0,0:01:21.96,0:01:23.08,Sub,,0,0,0,,vuelta no es
Dialogue: 0,0:01:23.09,0:01:23.84,Sub,,0,0,0,,el virus,
Dialogue: 0,0:01:23.85,0:01:24.97,Sub,,0,0,0,,sino la cobertura
Dialogue: 0,0:01:24.98,0:01:26.11,Sub,,0,0,0,,que se perdió.
Dialogue: 0,0:01:26.12,0:01:27.24,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:27.25,0:01:28.31,Sub,,0,0,0,,y ociosidades.
