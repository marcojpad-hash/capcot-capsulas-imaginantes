Dialogue: 0,0:00:00.30,0:00:00.97,Sub,,0,0,0,,Un pedazo de
Dialogue: 0,0:00:00.98,0:00:02.07,Sub,,0,0,0,,ADN artificial se
Dialogue: 0,0:00:02.08,0:00:02.95,Sub,,0,0,0,,enrosca sobre un
Dialogue: 0,0:00:02.96,0:00:03.72,Sub,,0,0,0,,gen del cáncer
Dialogue: 0,0:00:03.73,0:00:04.16,Sub,,0,0,0,,y le baja
Dialogue: 0,0:00:04.17,0:00:05.02,Sub,,0,0,0,,el volumen.
Dialogue: 0,0:00:05.24,0:00:06.09,Sub,,0,0,0,,La idea tenía
Dialogue: 0,0:00:06.10,0:00:07.45,Sub,,0,0,0,,décadas esperando.
Dialogue: 0,0:00:07.93,0:00:08.41,Sub,,0,0,0,,Por más de
Dialogue: 0,0:00:08.42,0:00:09.39,Sub,,0,0,0,,20 años,
Dialogue: 0,0:00:09.40,0:00:10.40,Sub,,0,0,0,,David Rusling,
Dialogue: 0,0:00:10.41,0:00:11.27,Sub,,0,0,0,,de la Universidad
Dialogue: 0,0:00:11.28,0:00:12.11,Sub,,0,0,0,,de Portsmouth,
Dialogue: 0,0:00:12.12,0:00:13.10,Sub,,0,0,0,,en Inglaterra,
Dialogue: 0,0:00:13.11,0:00:13.92,Sub,,0,0,0,,ha estudiado los
Dialogue: 0,0:00:13.93,0:00:15.40,Sub,,0,0,0,,oligonucleótidos que forman
Dialogue: 0,0:00:15.41,0:00:16.55,Sub,,0,0,0,,triple hélice.
Dialogue: 0,0:00:17.04,0:00:17.77,Sub,,0,0,0,,Se les llama
Dialogue: 0,0:00:17.78,0:00:18.72,Sub,,0,0,0,,TFO.
Dialogue: 0,0:00:18.94,0:00:20.11,Sub,,0,0,0,,Reconocen una secuencia
Dialogue: 0,0:00:20.12,0:00:21.09,Sub,,0,0,0,,exacta del ADN
Dialogue: 0,0:00:21.10,0:00:21.90,Sub,,0,0,0,,de doble cadena
Dialogue: 0,0:00:21.91,0:00:22.60,Sub,,0,0,0,,y se acomodan
Dialogue: 0,0:00:22.61,0:00:23.37,Sub,,0,0,0,,sobre ella como
Dialogue: 0,0:00:23.38,0:00:24.76,Sub,,0,0,0,,una tercera hebra.
Dialogue: 0,0:00:25.25,0:00:25.79,Sub,,0,0,0,,En el tubo
Dialogue: 0,0:00:25.80,0:00:26.91,Sub,,0,0,0,,de ensayo funcionaban
Dialogue: 0,0:00:26.92,0:00:27.85,Sub,,0,0,0,,de maravilla.
Dialogue: 0,0:00:28.07,0:00:28.68,Sub,,0,0,0,,Pero dentro de
Dialogue: 0,0:00:28.69,0:00:29.57,Sub,,0,0,0,,las células,
Dialogue: 0,0:00:29.58,0:00:30.30,Sub,,0,0,0,,la química del
Dialogue: 0,0:00:30.31,0:00:31.40,Sub,,0,0,0,,ADN natural no
Dialogue: 0,0:00:31.41,0:00:32.36,Sub,,0,0,0,,los dejaba unirse
Dialogue: 0,0:00:32.37,0:00:33.29,Sub,,0,0,0,,con fuerza.
Dialogue: 0,0:00:33.77,0:00:34.48,Sub,,0,0,0,,Las zonas más
Dialogue: 0,0:00:34.49,0:00:35.44,Sub,,0,0,0,,difíciles eran las
Dialogue: 0,0:00:35.45,0:00:36.21,Sub,,0,0,0,,ricas en guanina
Dialogue: 0,0:00:36.22,0:00:37.15,Sub,,0,0,0,,y citosina,
Dialogue: 0,0:00:37.16,0:00:38.27,Sub,,0,0,0,,regiones que controlan
Dialogue: 0,0:00:38.28,0:00:39.08,Sub,,0,0,0,,cuándo se enciende
Dialogue: 0,0:00:39.09,0:00:39.85,Sub,,0,0,0,,un gen.
Dialogue: 0,0:00:40.34,0:00:41.25,Sub,,0,0,0,,El giro:
Dialogue: 0,0:00:41.40,0:00:42.20,Sub,,0,0,0,,el equipo agregó
Dialogue: 0,0:00:42.21,0:00:43.28,Sub,,0,0,0,,una base sintética
Dialogue: 0,0:00:43.29,0:00:44.31,Sub,,0,0,0,,llamada Z,
Dialogue: 0,0:00:44.32,0:00:44.75,Sub,,0,0,0,,que ya se
Dialogue: 0,0:00:44.76,0:00:46.21,Sub,,0,0,0,,vende comercialmente.
Dialogue: 0,0:00:46.43,0:00:47.18,Sub,,0,0,0,,Con ella,
Dialogue: 0,0:00:47.21,0:00:47.93,Sub,,0,0,0,,los TFO se
Dialogue: 0,0:00:47.94,0:00:48.70,Sub,,0,0,0,,unieron con más
Dialogue: 0,0:00:48.71,0:00:50.03,Sub,,0,0,0,,fuerza y precisión.
Dialogue: 0,0:00:50.52,0:00:51.24,Sub,,0,0,0,,Lo probaron en
Dialogue: 0,0:00:51.25,0:00:52.37,Sub,,0,0,0,,MYC,
Dialogue: 0,0:00:52.40,0:00:52.84,Sub,,0,0,0,,un gen que
Dialogue: 0,0:00:52.85,0:00:54.20,Sub,,0,0,0,,impulsa muchos cánceres
Dialogue: 0,0:00:54.21,0:00:55.39,Sub,,0,0,0,,cuando se acelera.
Dialogue: 0,0:00:55.61,0:00:56.57,Sub,,0,0,0,,Su actividad bajó
Dialogue: 0,0:00:56.58,0:00:57.31,Sub,,0,0,0,,entre 50 y
Dialogue: 0,0:00:57.32,0:00:58.20,Sub,,0,0,0,,80 por ciento
Dialogue: 0,0:00:58.21,0:00:59.06,Sub,,0,0,0,,en experimentos de
Dialogue: 0,0:00:59.07,0:01:00.05,Sub,,0,0,0,,laboratorio.
Dialogue: 0,0:01:00.55,0:01:01.70,Sub,,0,0,0,,Superaron al ADN
Dialogue: 0,0:01:01.71,0:01:02.60,Sub,,0,0,0,,sin modificar y
Dialogue: 0,0:01:02.61,0:01:03.49,Sub,,0,0,0,,a otros métodos
Dialogue: 0,0:01:03.50,0:01:04.34,Sub,,0,0,0,,previos.
Dialogue: 0,0:01:04.56,0:01:05.42,Sub,,0,0,0,,Aún falta mucha
Dialogue: 0,0:01:05.43,0:01:06.50,Sub,,0,0,0,,investigación antes de
Dialogue: 0,0:01:06.51,0:01:07.95,Sub,,0,0,0,,pensar en pacientes.
Dialogue: 0,0:01:08.44,0:01:08.97,Sub,,0,0,0,,Por ahora es
Dialogue: 0,0:01:08.98,0:01:09.78,Sub,,0,0,0,,una herramienta para
Dialogue: 0,0:01:09.79,0:01:10.60,Sub,,0,0,0,,apagar genes y
Dialogue: 0,0:01:10.61,0:01:11.86,Sub,,0,0,0,,estudiar qué pasa.
Dialogue: 0,0:01:12.08,0:01:12.47,Sub,,0,0,0,,¿Qué gen te
Dialogue: 0,0:01:12.48,0:01:13.80,Sub,,0,0,0,,gustaría poder silenciar
Dialogue: 0,0:01:13.81,0:01:14.68,Sub,,0,0,0,,a la medida?
Dialogue: 0,0:01:14.93,0:01:15.77,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:15.78,0:01:16.94,Sub,,0,0,0,,y ociosidades.
