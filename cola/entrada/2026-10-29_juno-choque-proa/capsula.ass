Dialogue: 0,0:00:00.30,0:00:01.16,Sub,,0,0,0,,Juno cruzó dos
Dialogue: 0,0:00:01.17,0:00:02.07,Sub,,0,0,0,,veces una frontera
Dialogue: 0,0:00:02.08,0:00:02.91,Sub,,0,0,0,,invisible frente a
Dialogue: 0,0:00:02.92,0:00:03.78,Sub,,0,0,0,,Júpiter.
Dialogue: 0,0:00:04.28,0:00:04.80,Sub,,0,0,0,,No es una
Dialogue: 0,0:00:04.81,0:00:05.90,Sub,,0,0,0,,pared sólida:
Dialogue: 0,0:00:06.05,0:00:06.66,Sub,,0,0,0,,es el choque
Dialogue: 0,0:00:06.67,0:00:07.39,Sub,,0,0,0,,de proa,
Dialogue: 0,0:00:07.40,0:00:08.01,Sub,,0,0,0,,donde el viento
Dialogue: 0,0:00:08.02,0:00:08.83,Sub,,0,0,0,,solar encuentra el
Dialogue: 0,0:00:08.84,0:00:10.01,Sub,,0,0,0,,entorno magnético del
Dialogue: 0,0:00:10.02,0:00:11.07,Sub,,0,0,0,,planeta y empieza
Dialogue: 0,0:00:11.08,0:00:12.00,Sub,,0,0,0,,a frenarse.
Dialogue: 0,0:00:12.48,0:00:13.38,Sub,,0,0,0,,La nave registró
Dialogue: 0,0:00:13.39,0:00:14.06,Sub,,0,0,0,,los cruces el
Dialogue: 0,0:00:14.07,0:00:14.59,Sub,,0,0,0,,diez y el
Dialogue: 0,0:00:14.60,0:00:15.45,Sub,,0,0,0,,once de diciembre
Dialogue: 0,0:00:15.46,0:00:15.97,Sub,,0,0,0,,de dos mil
Dialogue: 0,0:00:15.98,0:00:16.98,Sub,,0,0,0,,veinticuatro.
Dialogue: 0,0:00:17.20,0:00:18.10,Sub,,0,0,0,,Cada paso ofreció
Dialogue: 0,0:00:18.11,0:00:19.15,Sub,,0,0,0,,una mirada distinta
Dialogue: 0,0:00:19.16,0:00:20.38,Sub,,0,0,0,,al mismo límite.
Dialogue: 0,0:00:20.86,0:00:21.68,Sub,,0,0,0,,Su instrumento de
Dialogue: 0,0:00:21.69,0:00:22.59,Sub,,0,0,0,,ondas registró el
Dialogue: 0,0:00:22.60,0:00:23.39,Sub,,0,0,0,,campo eléctrico a
Dialogue: 0,0:00:23.40,0:00:24.54,Sub,,0,0,0,,cincuenta mil muestras
Dialogue: 0,0:00:24.55,0:00:25.49,Sub,,0,0,0,,por segundo.
Dialogue: 0,0:00:25.71,0:00:26.57,Sub,,0,0,0,,Los registros de
Dialogue: 0,0:00:26.58,0:00:27.48,Sub,,0,0,0,,alta resolución de
Dialogue: 0,0:00:27.49,0:00:28.98,Sub,,0,0,0,,misiones anteriores llegaban
Dialogue: 0,0:00:28.99,0:00:30.11,Sub,,0,0,0,,a veintiocho mil.
Dialogue: 0,0:00:30.60,0:00:31.64,Sub,,0,0,0,,Aparecieron ondas de
Dialogue: 0,0:00:31.65,0:00:32.34,Sub,,0,0,0,,Langmuir,
Dialogue: 0,0:00:32.35,0:00:33.25,Sub,,0,0,0,,ondas acústicas de
Dialogue: 0,0:00:33.26,0:00:33.90,Sub,,0,0,0,,iones y una
Dialogue: 0,0:00:33.91,0:00:35.16,Sub,,0,0,0,,inestabilidad que surge
Dialogue: 0,0:00:35.17,0:00:36.03,Sub,,0,0,0,,cuando electrones e
Dialogue: 0,0:00:36.04,0:00:37.00,Sub,,0,0,0,,iones se desplazan
Dialogue: 0,0:00:37.01,0:00:38.28,Sub,,0,0,0,,de forma diferente.
Dialogue: 0,0:00:38.76,0:00:39.68,Sub,,0,0,0,,La sorpresa fueron
Dialogue: 0,0:00:39.69,0:00:40.86,Sub,,0,0,0,,los armónicos:
Dialogue: 0,0:00:41.01,0:00:42.36,Sub,,0,0,0,,varias frecuencias actuando
Dialogue: 0,0:00:42.37,0:00:43.22,Sub,,0,0,0,,juntas.
Dialogue: 0,0:00:43.44,0:00:44.87,Sub,,0,0,0,,También surgieron estructuras
Dialogue: 0,0:00:44.88,0:00:46.26,Sub,,0,0,0,,periódicas que reaparecían
Dialogue: 0,0:00:46.27,0:00:47.77,Sub,,0,0,0,,aproximadamente cada ocho
Dialogue: 0,0:00:47.78,0:00:49.16,Sub,,0,0,0,,coma tres segundos.
Dialogue: 0,0:00:49.65,0:00:50.66,Sub,,0,0,0,,Esas ondas ayudan
Dialogue: 0,0:00:50.67,0:00:51.70,Sub,,0,0,0,,a transferir energía
Dialogue: 0,0:00:51.71,0:00:52.54,Sub,,0,0,0,,del viento solar
Dialogue: 0,0:00:52.55,0:00:53.63,Sub,,0,0,0,,a las partículas,
Dialogue: 0,0:00:53.64,0:00:55.56,Sub,,0,0,0,,calentándolas y frenándolas.
Dialogue: 0,0:00:55.78,0:00:56.77,Sub,,0,0,0,,Júpiter muestra un
Dialogue: 0,0:00:56.78,0:00:57.81,Sub,,0,0,0,,choque más intenso
Dialogue: 0,0:00:57.82,0:00:58.88,Sub,,0,0,0,,que el terrestre.
Dialogue: 0,0:00:59.37,0:00:59.80,Sub,,0,0,0,,No es un
Dialogue: 0,0:00:59.81,0:01:00.77,Sub,,0,0,0,,escudo perfecto ni
Dialogue: 0,0:01:00.78,0:01:01.46,Sub,,0,0,0,,una barrera que
Dialogue: 0,0:01:01.47,0:01:02.56,Sub,,0,0,0,,detenga todo.
Dialogue: 0,0:01:02.78,0:01:03.62,Sub,,0,0,0,,Es un laboratorio
Dialogue: 0,0:01:03.63,0:01:04.70,Sub,,0,0,0,,natural para entender
Dialogue: 0,0:01:04.71,0:01:05.86,Sub,,0,0,0,,choques de plasma,
Dialogue: 0,0:01:05.87,0:01:06.61,Sub,,0,0,0,,incluso los que
Dialogue: 0,0:01:06.62,0:01:07.46,Sub,,0,0,0,,rodean restos de
Dialogue: 0,0:01:07.47,0:01:08.55,Sub,,0,0,0,,supernovas.
Dialogue: 0,0:01:08.77,0:01:09.62,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:09.63,0:01:10.78,Sub,,0,0,0,,y ociosidades.
