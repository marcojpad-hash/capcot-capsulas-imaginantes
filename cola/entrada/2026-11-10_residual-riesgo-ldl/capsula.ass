Dialogue: 0,0:00:00.30,0:00:00.81,Sub,,0,0,0,,¿Por qué llega
Dialogue: 0,0:00:00.82,0:00:01.61,Sub,,0,0,0,,un infarto aunque
Dialogue: 0,0:00:01.62,0:00:02.13,Sub,,0,0,0,,ya bajó el
Dialogue: 0,0:00:02.14,0:00:03.32,Sub,,0,0,0,,colesterol malo?
Dialogue: 0,0:00:03.57,0:00:04.18,Sub,,0,0,0,,Un equipo de
Dialogue: 0,0:00:04.19,0:00:04.84,Sub,,0,0,0,,Chalmers,
Dialogue: 0,0:00:04.85,0:00:05.70,Sub,,0,0,0,,en Suecia,
Dialogue: 0,0:00:05.71,0:00:06.59,Sub,,0,0,0,,buscó la respuesta
Dialogue: 0,0:00:06.60,0:00:07.50,Sub,,0,0,0,,en la sangre.
Dialogue: 0,0:00:08.00,0:00:09.02,Sub,,0,0,0,,Bajar el colesterol
Dialogue: 0,0:00:09.03,0:00:10.17,Sub,,0,0,0,,LDL sí reduce
Dialogue: 0,0:00:10.18,0:00:10.74,Sub,,0,0,0,,el riesgo de
Dialogue: 0,0:00:10.75,0:00:11.57,Sub,,0,0,0,,infarto.
Dialogue: 0,0:00:11.79,0:00:12.49,Sub,,0,0,0,,Pero llevarlo al
Dialogue: 0,0:00:12.50,0:00:13.61,Sub,,0,0,0,,rango recomendado no
Dialogue: 0,0:00:13.62,0:00:14.41,Sub,,0,0,0,,lo borra:
Dialogue: 0,0:00:14.56,0:00:15.34,Sub,,0,0,0,,queda un riesgo
Dialogue: 0,0:00:15.35,0:00:16.20,Sub,,0,0,0,,residual.
Dialogue: 0,0:00:16.68,0:00:17.62,Sub,,0,0,0,,El colesterol no
Dialogue: 0,0:00:17.63,0:00:18.65,Sub,,0,0,0,,viaja solo:
Dialogue: 0,0:00:18.80,0:00:19.82,Sub,,0,0,0,,lo llevan partículas
Dialogue: 0,0:00:19.83,0:00:21.50,Sub,,0,0,0,,llamadas lipoproteínas.
Dialogue: 0,0:00:21.72,0:00:22.68,Sub,,0,0,0,,Tres tipos cargan
Dialogue: 0,0:00:22.69,0:00:23.72,Sub,,0,0,0,,una proteína llamada
Dialogue: 0,0:00:23.73,0:00:25.15,Sub,,0,0,0,,apolipoproteína B.
Dialogue: 0,0:00:25.63,0:00:26.93,Sub,,0,0,0,,Son el LDL,
Dialogue: 0,0:00:26.94,0:00:28.23,Sub,,0,0,0,,las lipoproteínas ricas
Dialogue: 0,0:00:28.24,0:00:29.33,Sub,,0,0,0,,en triglicéridos,
Dialogue: 0,0:00:29.34,0:00:30.35,Sub,,0,0,0,,o TRL,
Dialogue: 0,0:00:30.36,0:00:31.36,Sub,,0,0,0,,y la lipoproteína
Dialogue: 0,0:00:31.37,0:00:31.91,Sub,,0,0,0,,a.
Dialogue: 0,0:00:32.13,0:00:32.90,Sub,,0,0,0,,Las tres pueden
Dialogue: 0,0:00:32.91,0:00:33.85,Sub,,0,0,0,,dejar colesterol en
Dialogue: 0,0:00:33.86,0:00:34.51,Sub,,0,0,0,,las paredes de
Dialogue: 0,0:00:34.52,0:00:35.61,Sub,,0,0,0,,las arterias.
Dialogue: 0,0:00:36.10,0:00:36.91,Sub,,0,0,0,,El equipo midió
Dialogue: 0,0:00:36.92,0:00:38.24,Sub,,0,0,0,,casi 3000 proteínas
Dialogue: 0,0:00:38.25,0:00:38.84,Sub,,0,0,0,,en sangre y
Dialogue: 0,0:00:38.85,0:00:39.53,Sub,,0,0,0,,las cruzó con
Dialogue: 0,0:00:39.54,0:00:40.58,Sub,,0,0,0,,datos genéticos y
Dialogue: 0,0:00:40.59,0:00:41.96,Sub,,0,0,0,,registros de salud.
Dialogue: 0,0:00:42.45,0:00:43.49,Sub,,0,0,0,,La sorpresa:
Dialogue: 0,0:00:43.64,0:00:44.67,Sub,,0,0,0,,las TRL y
Dialogue: 0,0:00:44.68,0:00:45.62,Sub,,0,0,0,,la lipoproteína a
Dialogue: 0,0:00:45.63,0:00:46.73,Sub,,0,0,0,,mostraron patrones de
Dialogue: 0,0:00:46.74,0:00:48.37,Sub,,0,0,0,,proteínas muy parecidos,
Dialogue: 0,0:00:48.38,0:00:49.25,Sub,,0,0,0,,y esos patrones
Dialogue: 0,0:00:49.26,0:00:49.81,Sub,,0,0,0,,se ligaron a
Dialogue: 0,0:00:49.82,0:00:51.78,Sub,,0,0,0,,enfermedad cardiaca posterior.
Dialogue: 0,0:00:52.27,0:00:53.45,Sub,,0,0,0,,Esas partículas llevan
Dialogue: 0,0:00:53.46,0:00:54.50,Sub,,0,0,0,,proteínas que atraen
Dialogue: 0,0:00:54.51,0:00:55.56,Sub,,0,0,0,,células inmunes y
Dialogue: 0,0:00:55.57,0:00:56.52,Sub,,0,0,0,,podrían inflamar la
Dialogue: 0,0:00:56.53,0:00:57.04,Sub,,0,0,0,,pared de los
Dialogue: 0,0:00:57.05,0:00:57.65,Sub,,0,0,0,,vasos,
Dialogue: 0,0:00:57.66,0:00:58.20,Sub,,0,0,0,,más allá de
Dialogue: 0,0:00:58.21,0:00:59.69,Sub,,0,0,0,,depositar colesterol.
Dialogue: 0,0:01:00.19,0:01:01.31,Sub,,0,0,0,,El LDL mostró
Dialogue: 0,0:01:01.32,0:01:02.24,Sub,,0,0,0,,otro patrón,
Dialogue: 0,0:01:02.25,0:01:03.11,Sub,,0,0,0,,ligado a acumular
Dialogue: 0,0:01:03.12,0:01:03.96,Sub,,0,0,0,,colesterol,
Dialogue: 0,0:01:03.97,0:01:04.79,Sub,,0,0,0,,y bajarlo sigue
Dialogue: 0,0:01:04.80,0:01:05.93,Sub,,0,0,0,,siendo la base.
Dialogue: 0,0:01:06.15,0:01:06.92,Sub,,0,0,0,,El estudio no
Dialogue: 0,0:01:06.93,0:01:07.92,Sub,,0,0,0,,probó un tratamiento
Dialogue: 0,0:01:07.93,0:01:08.59,Sub,,0,0,0,,ni una prueba
Dialogue: 0,0:01:08.60,0:01:09.42,Sub,,0,0,0,,clínica.
Dialogue: 0,0:01:09.90,0:01:10.37,Sub,,0,0,0,,Pero ya hay
Dialogue: 0,0:01:10.38,0:01:11.07,Sub,,0,0,0,,pistas de por
Dialogue: 0,0:01:11.08,0:01:12.28,Sub,,0,0,0,,qué queda riesgo.
Dialogue: 0,0:01:12.50,0:01:13.79,Sub,,0,0,0,,¿Qué partículas deberíamos
Dialogue: 0,0:01:13.80,0:01:14.62,Sub,,0,0,0,,medir además del
Dialogue: 0,0:01:14.63,0:01:15.56,Sub,,0,0,0,,LDL?
Dialogue: 0,0:01:15.81,0:01:16.65,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:16.66,0:01:17.82,Sub,,0,0,0,,y ociosidades.
