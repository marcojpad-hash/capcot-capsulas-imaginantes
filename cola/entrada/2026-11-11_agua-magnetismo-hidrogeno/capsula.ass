Dialogue: 0,0:00:00.30,0:00:01.23,Sub,,0,0,0,,En Sendai,
Dialogue: 0,0:00:01.25,0:00:01.93,Sub,,0,0,0,,un equipo vio
Dialogue: 0,0:00:01.94,0:00:03.13,Sub,,0,0,0,,algo inesperado:
Dialogue: 0,0:00:03.28,0:00:04.04,Sub,,0,0,0,,el agua ordenó
Dialogue: 0,0:00:04.05,0:00:05.21,Sub,,0,0,0,,imanes lejanos,
Dialogue: 0,0:00:05.22,0:00:05.92,Sub,,0,0,0,,iones de cobre
Dialogue: 0,0:00:05.93,0:00:06.60,Sub,,0,0,0,,que no estaban
Dialogue: 0,0:00:06.61,0:00:07.31,Sub,,0,0,0,,unidos por un
Dialogue: 0,0:00:07.32,0:00:08.45,Sub,,0,0,0,,enlace fuerte.
Dialogue: 0,0:00:08.93,0:00:10.21,Sub,,0,0,0,,Investigadores de Tohoku
Dialogue: 0,0:00:10.22,0:00:11.07,Sub,,0,0,0,,University,
Dialogue: 0,0:00:11.08,0:00:11.94,Sub,,0,0,0,,en Japón,
Dialogue: 0,0:00:11.95,0:00:12.53,Sub,,0,0,0,,y de Taipei
Dialogue: 0,0:00:12.54,0:00:13.74,Sub,,0,0,0,,Tech enfriaron cristales
Dialogue: 0,0:00:13.75,0:00:14.45,Sub,,0,0,0,,de complejos de
Dialogue: 0,0:00:14.46,0:00:15.41,Sub,,0,0,0,,cobre fluorado para
Dialogue: 0,0:00:15.42,0:00:16.97,Sub,,0,0,0,,estudiar su magnetismo.
Dialogue: 0,0:00:17.45,0:00:18.41,Sub,,0,0,0,,Cuando la temperatura
Dialogue: 0,0:00:18.42,0:00:19.42,Sub,,0,0,0,,bajó de 260
Dialogue: 0,0:00:19.43,0:00:20.36,Sub,,0,0,0,,kelvin,
Dialogue: 0,0:00:20.37,0:00:21.14,Sub,,0,0,0,,las moléculas de
Dialogue: 0,0:00:21.15,0:00:22.01,Sub,,0,0,0,,agua se alinearon
Dialogue: 0,0:00:22.02,0:00:22.96,Sub,,0,0,0,,y formaron puentes
Dialogue: 0,0:00:22.97,0:00:23.76,Sub,,0,0,0,,de hidrógeno entre
Dialogue: 0,0:00:23.77,0:00:24.66,Sub,,0,0,0,,iones que antes
Dialogue: 0,0:00:24.67,0:00:26.12,Sub,,0,0,0,,no estaban ligados.
Dialogue: 0,0:00:26.59,0:00:27.65,Sub,,0,0,0,,Esos puentes unieron
Dialogue: 0,0:00:27.66,0:00:28.31,Sub,,0,0,0,,iones de cobre
Dialogue: 0,0:00:28.32,0:00:29.41,Sub,,0,0,0,,distantes y crearon
Dialogue: 0,0:00:29.42,0:00:31.27,Sub,,0,0,0,,pares antiferromagnéticos:
Dialogue: 0,0:00:31.42,0:00:32.66,Sub,,0,0,0,,momentos magnéticos que
Dialogue: 0,0:00:32.67,0:00:33.59,Sub,,0,0,0,,se cancelan,
Dialogue: 0,0:00:33.60,0:00:34.30,Sub,,0,0,0,,con una fuerza
Dialogue: 0,0:00:34.31,0:00:35.07,Sub,,0,0,0,,de unos 10
Dialogue: 0,0:00:35.08,0:00:35.71,Sub,,0,0,0,,kelvin.
Dialogue: 0,0:00:36.19,0:00:37.07,Sub,,0,0,0,,El estudio,
Dialogue: 0,0:00:37.08,0:00:38.12,Sub,,0,0,0,,publicado en Inorganic
Dialogue: 0,0:00:38.13,0:00:38.99,Sub,,0,0,0,,Chemistry por Nawa
Dialogue: 0,0:00:39.00,0:00:39.81,Sub,,0,0,0,,y colegas,
Dialogue: 0,0:00:39.82,0:00:40.40,Sub,,0,0,0,,muestra que la
Dialogue: 0,0:00:40.41,0:00:41.35,Sub,,0,0,0,,orientación del agua
Dialogue: 0,0:00:41.36,0:00:42.56,Sub,,0,0,0,,controla el acoplamiento
Dialogue: 0,0:00:42.57,0:00:44.10,Sub,,0,0,0,,magnético a distancia.
Dialogue: 0,0:00:44.59,0:00:45.48,Sub,,0,0,0,,Lo confirmaron con
Dialogue: 0,0:00:45.49,0:00:46.83,Sub,,0,0,0,,difracción de neutrones,
Dialogue: 0,0:00:46.84,0:00:47.55,Sub,,0,0,0,,que localiza el
Dialogue: 0,0:00:47.56,0:00:48.31,Sub,,0,0,0,,hidrógeno,
Dialogue: 0,0:00:48.32,0:00:49.09,Sub,,0,0,0,,y con cálculos
Dialogue: 0,0:00:49.10,0:00:49.71,Sub,,0,0,0,,de teoría del
Dialogue: 0,0:00:49.72,0:00:50.39,Sub,,0,0,0,,funcional de la
Dialogue: 0,0:00:50.40,0:00:51.10,Sub,,0,0,0,,densidad,
Dialogue: 0,0:00:51.11,0:00:52.16,Sub,,0,0,0,,o DFT.
Dialogue: 0,0:00:52.65,0:00:53.40,Sub,,0,0,0,,No hace falta
Dialogue: 0,0:00:53.41,0:00:54.46,Sub,,0,0,0,,un enlace covalente
Dialogue: 0,0:00:54.47,0:00:55.28,Sub,,0,0,0,,rígido:
Dialogue: 0,0:00:55.43,0:00:56.50,Sub,,0,0,0,,al ordenarse,
Dialogue: 0,0:00:56.52,0:00:57.27,Sub,,0,0,0,,una molécula de
Dialogue: 0,0:00:57.28,0:00:58.11,Sub,,0,0,0,,agua común puede
Dialogue: 0,0:00:58.12,0:00:59.14,Sub,,0,0,0,,sintonizar cómo se
Dialogue: 0,0:00:59.15,0:01:00.03,Sub,,0,0,0,,hablan dos centros
Dialogue: 0,0:01:00.04,0:01:01.11,Sub,,0,0,0,,magnéticos.
Dialogue: 0,0:01:01.60,0:01:02.29,Sub,,0,0,0,,Eso abre una
Dialogue: 0,0:01:02.30,0:01:03.44,Sub,,0,0,0,,pista para materiales
Dialogue: 0,0:01:03.45,0:01:04.52,Sub,,0,0,0,,magnéticos:
Dialogue: 0,0:01:04.67,0:01:05.52,Sub,,0,0,0,,mover u orientar
Dialogue: 0,0:01:05.53,0:01:06.23,Sub,,0,0,0,,el agua,
Dialogue: 0,0:01:06.25,0:01:06.98,Sub,,0,0,0,,no solo cambiar
Dialogue: 0,0:01:06.99,0:01:07.53,Sub,,0,0,0,,el metal o
Dialogue: 0,0:01:07.54,0:01:08.13,Sub,,0,0,0,,el ligando que
Dialogue: 0,0:01:08.14,0:01:08.98,Sub,,0,0,0,,lo rodea.
Dialogue: 0,0:01:09.47,0:01:10.17,Sub,,0,0,0,,Así,
Dialogue: 0,0:01:10.18,0:01:11.04,Sub,,0,0,0,,el agua cotidiana
Dialogue: 0,0:01:11.05,0:01:12.60,Sub,,0,0,0,,puede sintonizar magnetismo
Dialogue: 0,0:01:12.61,0:01:14.13,Sub,,0,0,0,,sin enlaces fuertes.
Dialogue: 0,0:01:14.35,0:01:15.09,Sub,,0,0,0,,¿Qué más esconde
Dialogue: 0,0:01:15.10,0:01:15.96,Sub,,0,0,0,,una molécula tan
Dialogue: 0,0:01:15.97,0:01:16.69,Sub,,0,0,0,,simple?
Dialogue: 0,0:01:16.94,0:01:17.79,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:17.80,0:01:18.95,Sub,,0,0,0,,y ociosidades.
