Dialogue: 0,0:00:00.30,0:00:01.34,Sub,,0,0,0,,En un acuario,
Dialogue: 0,0:00:01.35,0:00:02.03,Sub,,0,0,0,,dos corales se
Dialogue: 0,0:00:02.04,0:00:03.54,Sub,,0,0,0,,tocaron por accidente.
Dialogue: 0,0:00:04.01,0:00:05.42,Sub,,0,0,0,,Uno estaba blanqueado;
Dialogue: 0,0:00:05.57,0:00:06.56,Sub,,0,0,0,,el otro conservaba
Dialogue: 0,0:00:06.57,0:00:08.10,Sub,,0,0,0,,sus algas simbiontes.
Dialogue: 0,0:00:08.32,0:00:09.47,Sub,,0,0,0,,Steve Palumbi notó
Dialogue: 0,0:00:09.48,0:00:09.93,Sub,,0,0,0,,que,
Dialogue: 0,0:00:09.94,0:00:11.04,Sub,,0,0,0,,donde se rozaban,
Dialogue: 0,0:00:11.05,0:00:11.80,Sub,,0,0,0,,el coral pálido
Dialogue: 0,0:00:11.81,0:00:12.88,Sub,,0,0,0,,empezaba a recuperar
Dialogue: 0,0:00:12.89,0:00:13.60,Sub,,0,0,0,,color.
Dialogue: 0,0:00:14.09,0:00:15.10,Sub,,0,0,0,,El equipo convirtió
Dialogue: 0,0:00:15.11,0:00:16.01,Sub,,0,0,0,,esa observación en
Dialogue: 0,0:00:16.02,0:00:17.18,Sub,,0,0,0,,un experimento:
Dialogue: 0,0:00:17.33,0:00:18.77,Sub,,0,0,0,,cinco fragmentos blanqueados
Dialogue: 0,0:00:18.78,0:00:20.30,Sub,,0,0,0,,tocaron clones sanos;
Dialogue: 0,0:00:20.45,0:00:21.42,Sub,,0,0,0,,otros cinco quedaron
Dialogue: 0,0:00:21.43,0:00:23.18,Sub,,0,0,0,,separados por milímetros.
Dialogue: 0,0:00:23.67,0:00:24.54,Sub,,0,0,0,,La diferencia fue
Dialogue: 0,0:00:24.55,0:00:25.38,Sub,,0,0,0,,radical.
Dialogue: 0,0:00:25.60,0:00:26.23,Sub,,0,0,0,,Los cinco con
Dialogue: 0,0:00:26.24,0:00:27.47,Sub,,0,0,0,,contacto se recuperaron
Dialogue: 0,0:00:27.48,0:00:28.47,Sub,,0,0,0,,por completo;
Dialogue: 0,0:00:28.62,0:00:29.31,Sub,,0,0,0,,ninguno de los
Dialogue: 0,0:00:29.32,0:00:30.21,Sub,,0,0,0,,cinco aislados lo
Dialogue: 0,0:00:30.22,0:00:30.91,Sub,,0,0,0,,logró.
Dialogue: 0,0:00:31.13,0:00:31.89,Sub,,0,0,0,,Dos murieron y
Dialogue: 0,0:00:31.90,0:00:33.09,Sub,,0,0,0,,tres quedaron cubiertos
Dialogue: 0,0:00:33.10,0:00:33.97,Sub,,0,0,0,,de algas.
Dialogue: 0,0:00:34.46,0:00:35.19,Sub,,0,0,0,,En una segunda
Dialogue: 0,0:00:35.20,0:00:35.85,Sub,,0,0,0,,prueba,
Dialogue: 0,0:00:35.88,0:00:36.50,Sub,,0,0,0,,una semana de
Dialogue: 0,0:00:36.51,0:00:37.70,Sub,,0,0,0,,contacto bastó:
Dialogue: 0,0:00:37.85,0:00:38.96,Sub,,0,0,0,,sanaron por completo
Dialogue: 0,0:00:38.97,0:00:40.09,Sub,,0,0,0,,en siete semanas,
Dialogue: 0,0:00:40.10,0:00:41.00,Sub,,0,0,0,,incluso después de
Dialogue: 0,0:00:41.01,0:00:42.02,Sub,,0,0,0,,separarlos.
Dialogue: 0,0:00:42.50,0:00:43.65,Sub,,0,0,0,,¿El mecanismo?
Dialogue: 0,0:00:43.90,0:00:44.62,Sub,,0,0,0,,Los tejidos de
Dialogue: 0,0:00:44.63,0:00:46.37,Sub,,0,0,0,,corales genéticamente idénticos
Dialogue: 0,0:00:46.38,0:00:47.35,Sub,,0,0,0,,pueden fusionarse y
Dialogue: 0,0:00:47.36,0:00:48.36,Sub,,0,0,0,,crear canales por
Dialogue: 0,0:00:48.37,0:00:49.01,Sub,,0,0,0,,los que pasan
Dialogue: 0,0:00:49.02,0:00:50.48,Sub,,0,0,0,,algas beneficiosas.
Dialogue: 0,0:00:50.97,0:00:52.14,Sub,,0,0,0,,Al microscopio,
Dialogue: 0,0:00:52.15,0:00:53.24,Sub,,0,0,0,,las algas aparecieron
Dialogue: 0,0:00:53.25,0:00:53.79,Sub,,0,0,0,,en el coral
Dialogue: 0,0:00:53.80,0:00:54.61,Sub,,0,0,0,,dañado desde el
Dialogue: 0,0:00:54.62,0:00:55.64,Sub,,0,0,0,,tercer día.
Dialogue: 0,0:00:55.86,0:00:57.05,Sub,,0,0,0,,Después se multiplicaron
Dialogue: 0,0:00:57.06,0:00:58.20,Sub,,0,0,0,,y devolvieron energía
Dialogue: 0,0:00:58.21,0:00:59.15,Sub,,0,0,0,,a su huésped.
Dialogue: 0,0:00:59.63,0:01:00.09,Sub,,0,0,0,,Pero no es
Dialogue: 0,0:01:00.10,0:01:00.85,Sub,,0,0,0,,una cura lista
Dialogue: 0,0:01:00.86,0:01:02.20,Sub,,0,0,0,,para los arrecifes:
Dialogue: 0,0:01:02.35,0:01:02.97,Sub,,0,0,0,,la prueba fue
Dialogue: 0,0:01:02.98,0:01:03.79,Sub,,0,0,0,,de laboratorio y
Dialogue: 0,0:01:03.80,0:01:04.78,Sub,,0,0,0,,depende de corales
Dialogue: 0,0:01:04.79,0:01:06.20,Sub,,0,0,0,,del mismo genotipo.
Dialogue: 0,0:01:06.42,0:01:07.22,Sub,,0,0,0,,Aún falta una
Dialogue: 0,0:01:07.23,0:01:08.37,Sub,,0,0,0,,forma escalable.
Dialogue: 0,0:01:08.85,0:01:09.54,Sub,,0,0,0,,La pista no
Dialogue: 0,0:01:09.55,0:01:09.88,Sub,,0,0,0,,es que el
Dialogue: 0,0:01:09.89,0:01:11.33,Sub,,0,0,0,,coral sea invencible:
Dialogue: 0,0:01:11.48,0:01:11.88,Sub,,0,0,0,,es que la
Dialogue: 0,0:01:11.89,0:01:13.21,Sub,,0,0,0,,recuperación puede empezar
Dialogue: 0,0:01:13.22,0:01:14.07,Sub,,0,0,0,,con una conexión
Dialogue: 0,0:01:14.08,0:01:14.88,Sub,,0,0,0,,precisa.
Dialogue: 0,0:01:15.10,0:01:15.98,Sub,,0,0,0,,¿Podremos llevar ese
Dialogue: 0,0:01:15.99,0:01:17.48,Sub,,0,0,0,,mecanismo al arrecife?
Dialogue: 0,0:01:17.73,0:01:18.57,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:18.58,0:01:19.73,Sub,,0,0,0,,y ociosidades.
