Dialogue: 0,0:00:00.30,0:00:01.02,Sub,,0,0,0,,Durante más de
Dialogue: 0,0:00:01.03,0:00:02.14,Sub,,0,0,0,,sesenta años,
Dialogue: 0,0:00:02.15,0:00:03.17,Sub,,0,0,0,,los químicos creyeron
Dialogue: 0,0:00:03.18,0:00:05.15,Sub,,0,0,0,,imposible aislar oxoboranos:
Dialogue: 0,0:00:05.30,0:00:06.33,Sub,,0,0,0,,moléculas con triple
Dialogue: 0,0:00:06.34,0:00:07.23,Sub,,0,0,0,,enlace entre boro
Dialogue: 0,0:00:07.24,0:00:08.14,Sub,,0,0,0,,y oxígeno,
Dialogue: 0,0:00:08.15,0:00:09.42,Sub,,0,0,0,,demasiado inestables para
Dialogue: 0,0:00:09.43,0:00:10.46,Sub,,0,0,0,,el laboratorio.
Dialogue: 0,0:00:10.95,0:00:11.85,Sub,,0,0,0,,En la Universidad
Dialogue: 0,0:00:11.86,0:00:12.74,Sub,,0,0,0,,de Würzburg,
Dialogue: 0,0:00:12.76,0:00:13.32,Sub,,0,0,0,,el equipo de
Dialogue: 0,0:00:13.33,0:00:14.49,Sub,,0,0,0,,Holger Braunschweig,
Dialogue: 0,0:00:14.50,0:00:15.71,Sub,,0,0,0,,con apoyo computacional
Dialogue: 0,0:00:15.72,0:00:16.50,Sub,,0,0,0,,de Tezpur,
Dialogue: 0,0:00:16.51,0:00:17.93,Sub,,0,0,0,,reaccionó un diboracumuleno
Dialogue: 0,0:00:17.94,0:00:19.05,Sub,,0,0,0,,reactivo con cetonas
Dialogue: 0,0:00:19.06,0:00:20.20,Sub,,0,0,0,,simples a temperatura
Dialogue: 0,0:00:20.21,0:00:21.03,Sub,,0,0,0,,ambiente.
Dialogue: 0,0:00:21.51,0:00:22.32,Sub,,0,0,0,,La sorpresa fue
Dialogue: 0,0:00:22.33,0:00:23.05,Sub,,0,0,0,,total:
Dialogue: 0,0:00:23.20,0:00:24.59,Sub,,0,0,0,,formaron tres oxoboranos
Dialogue: 0,0:00:24.60,0:00:25.74,Sub,,0,0,0,,estables como sólidos
Dialogue: 0,0:00:25.75,0:00:26.90,Sub,,0,0,0,,cristalinos naranja y
Dialogue: 0,0:00:26.91,0:00:27.63,Sub,,0,0,0,,amarillo,
Dialogue: 0,0:00:27.64,0:00:28.16,Sub,,0,0,0,,con más del
Dialogue: 0,0:00:28.17,0:00:29.19,Sub,,0,0,0,,cincuenta por ciento
Dialogue: 0,0:00:29.20,0:00:30.65,Sub,,0,0,0,,de rendimiento aislado.
Dialogue: 0,0:00:31.13,0:00:32.53,Sub,,0,0,0,,Los enlaces boro-oxígeno
Dialogue: 0,0:00:32.54,0:00:33.78,Sub,,0,0,0,,miden entre 1
Dialogue: 0,0:00:34.00,0:00:35.55,Sub,,0,0,0,,208 y 1
Dialogue: 0,0:00:35.77,0:00:38.35,Sub,,0,0,0,,217 angstroms Son
Dialogue: 0,0:00:38.36,0:00:39.64,Sub,,0,0,0,,extremadamente cortos y
Dialogue: 0,0:00:39.65,0:00:41.42,Sub,,0,0,0,,fuertes casi perfectamente
Dialogue: 0,0:00:41.43,0:00:42.87,Sub,,0,0,0,,lineales con evidencia
Dialogue: 0,0:00:42.88,0:00:43.73,Sub,,0,0,0,,de triple enlace
Dialogue: 0,0:00:43.74,0:00:45.58,Sub,,0,0,0,,real Antes,
Dialogue: 0,0:00:45.59,0:00:46.62,Sub,,0,0,0,,estas especies solo
Dialogue: 0,0:00:46.63,0:00:47.50,Sub,,0,0,0,,se habían detectado
Dialogue: 0,0:00:47.51,0:00:48.21,Sub,,0,0,0,,en fase gas
Dialogue: 0,0:00:48.22,0:00:48.90,Sub,,0,0,0,,o en matrices
Dialogue: 0,0:00:48.91,0:00:49.98,Sub,,0,0,0,,criogénicas.
Dialogue: 0,0:00:50.20,0:00:51.29,Sub,,0,0,0,,Nunca como compuestos
Dialogue: 0,0:00:51.30,0:00:52.45,Sub,,0,0,0,,estables a temperatura
Dialogue: 0,0:00:52.46,0:00:53.24,Sub,,0,0,0,,ambiente.
Dialogue: 0,0:00:53.71,0:00:54.51,Sub,,0,0,0,,El hallazgo abre
Dialogue: 0,0:00:54.52,0:00:55.63,Sub,,0,0,0,,caminos para preparar
Dialogue: 0,0:00:55.64,0:00:56.95,Sub,,0,0,0,,más moléculas elusivas
Dialogue: 0,0:00:56.96,0:00:57.98,Sub,,0,0,0,,del bloque p.
Dialogue: 0,0:00:58.20,0:00:58.95,Sub,,0,0,0,,Casi todos en
Dialogue: 0,0:00:58.96,0:00:59.66,Sub,,0,0,0,,el campo habían
Dialogue: 0,0:00:59.67,0:01:00.81,Sub,,0,0,0,,abandonado la búsqueda
Dialogue: 0,0:01:00.82,0:01:01.95,Sub,,0,0,0,,hace décadas.
Dialogue: 0,0:01:02.44,0:01:03.43,Sub,,0,0,0,,Ahora los químicos
Dialogue: 0,0:01:03.44,0:01:04.58,Sub,,0,0,0,,pueden estudiarlas,
Dialogue: 0,0:01:04.59,0:01:05.97,Sub,,0,0,0,,manipularlas y construir
Dialogue: 0,0:01:05.98,0:01:07.39,Sub,,0,0,0,,nuevas estructuras.
Dialogue: 0,0:01:07.61,0:01:08.39,Sub,,0,0,0,,Un paradigma de
Dialogue: 0,0:01:08.40,0:01:09.31,Sub,,0,0,0,,sesenta años de
Dialogue: 0,0:01:09.32,0:01:10.35,Sub,,0,0,0,,intentos fallidos se
Dialogue: 0,0:01:10.36,0:01:11.14,Sub,,0,0,0,,rompió de forma
Dialogue: 0,0:01:11.15,0:01:12.13,Sub,,0,0,0,,inesperada.
Dialogue: 0,0:01:12.62,0:01:13.55,Sub,,0,0,0,,¿Qué otras moléculas
Dialogue: 0,0:01:13.56,0:01:14.79,Sub,,0,0,0,,que creíamos imposibles
Dialogue: 0,0:01:14.80,0:01:16.03,Sub,,0,0,0,,esperan simplemente una
Dialogue: 0,0:01:16.04,0:01:17.25,Sub,,0,0,0,,reacción inesperada para
Dialogue: 0,0:01:17.26,0:01:18.61,Sub,,0,0,0,,volverse reales?
Dialogue: 0,0:01:18.86,0:01:19.70,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:19.71,0:01:20.86,Sub,,0,0,0,,y ociosidades.
