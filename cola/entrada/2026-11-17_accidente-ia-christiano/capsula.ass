Dialogue: 0,0:00:02.89,0:00:03.70,Sub,,0,0,0,,un alarmista de
Dialogue: 0,0:00:03.71,0:00:04.53,Sub,,0,0,0,,internet.
Dialogue: 0,0:00:04.61,0:00:05.20,Sub,,0,0,0,,Lo dice Paul
Dialogue: 0,0:00:05.21,0:00:05.93,Sub,,0,0,0,,Christiano,
Dialogue: 0,0:00:05.94,0:00:07.56,Sub,,0,0,0,,exinvestigador de OpenAI,
Dialogue: 0,0:00:07.57,0:00:07.90,Sub,,0,0,0,,hoy en su
Dialogue: 0,0:00:07.91,0:00:09.09,Sub,,0,0,0,,junta de seguridad.
Dialogue: 0,0:00:09.27,0:00:09.84,Sub,,0,0,0,,En Toronto,
Dialogue: 0,0:00:09.85,0:00:10.41,Sub,,0,0,0,,en las Hinton
Dialogue: 0,0:00:10.42,0:00:11.04,Sub,,0,0,0,,Lectures,
Dialogue: 0,0:00:11.05,0:00:11.92,Sub,,0,0,0,,dijo esto:
Dialogue: 0,0:00:11.93,0:00:12.32,Sub,,0,0,0,,para la mayoría
Dialogue: 0,0:00:12.33,0:00:12.86,Sub,,0,0,0,,de la gente
Dialogue: 0,0:00:12.87,0:00:13.83,Sub,,0,0,0,,en la sala,
Dialogue: 0,0:00:13.89,0:00:14.46,Sub,,0,0,0,,la razón más
Dialogue: 0,0:00:14.47,0:00:15.30,Sub,,0,0,0,,probable por la
Dialogue: 0,0:00:15.31,0:00:16.04,Sub,,0,0,0,,que morirán es
Dialogue: 0,0:00:16.05,0:00:16.98,Sub,,0,0,0,,por un accidente
Dialogue: 0,0:00:16.99,0:00:17.57,Sub,,0,0,0,,de IA.
Dialogue: 0,0:00:17.93,0:00:18.76,Sub,,0,0,0,,Sus números suenan
Dialogue: 0,0:00:18.77,0:00:19.63,Sub,,0,0,0,,a película:
Dialogue: 0,0:00:19.79,0:00:20.52,Sub,,0,0,0,,cincuenta por ciento
Dialogue: 0,0:00:20.53,0:00:21.04,Sub,,0,0,0,,de que la
Dialogue: 0,0:00:21.05,0:00:21.64,Sub,,0,0,0,,IA tome el
Dialogue: 0,0:00:21.65,0:00:22.36,Sub,,0,0,0,,control en tres
Dialogue: 0,0:00:22.37,0:00:22.70,Sub,,0,0,0,,años,
Dialogue: 0,0:00:22.71,0:00:23.42,Sub,,0,0,0,,y una de
Dialogue: 0,0:00:23.43,0:00:23.86,Sub,,0,0,0,,tres de que
Dialogue: 0,0:00:23.87,0:00:24.24,Sub,,0,0,0,,en un año
Dialogue: 0,0:00:24.25,0:00:25.48,Sub,,0,0,0,,haya sistemas capaces
Dialogue: 0,0:00:25.49,0:00:26.60,Sub,,0,0,0,,de derrocar gobiernos
Dialogue: 0,0:00:26.61,0:00:27.04,Sub,,0,0,0,,si se lo
Dialogue: 0,0:00:27.05,0:00:27.95,Sub,,0,0,0,,propusieran.
Dialogue: 0,0:00:28.05,0:00:28.74,Sub,,0,0,0,,Pero ojo:
Dialogue: 0,0:00:28.75,0:00:29.34,Sub,,0,0,0,,él mismo dice
Dialogue: 0,0:00:29.35,0:00:30.40,Sub,,0,0,0,,que son estimaciones
