Dialogue: 0,0:00:00.30,0:00:00.87,Sub,,0,0,0,,El arroz que
Dialogue: 0,0:00:00.88,0:00:01.44,Sub,,0,0,0,,dejaste en la
Dialogue: 0,0:00:01.45,0:00:03.03,Sub,,0,0,0,,estufa puede enfermarte.
Dialogue: 0,0:00:03.25,0:00:04.09,Sub,,0,0,0,,El problema no
Dialogue: 0,0:00:04.10,0:00:05.29,Sub,,0,0,0,,es recalentarlo:
Dialogue: 0,0:00:05.44,0:00:05.85,Sub,,0,0,0,,es lo que
Dialogue: 0,0:00:05.86,0:00:06.58,Sub,,0,0,0,,pasó mientras se
Dialogue: 0,0:00:06.59,0:00:07.38,Sub,,0,0,0,,enfriaba.
Dialogue: 0,0:00:07.88,0:00:08.46,Sub,,0,0,0,,En el arroz
Dialogue: 0,0:00:08.47,0:00:09.18,Sub,,0,0,0,,crudo pueden ir
Dialogue: 0,0:00:09.19,0:00:09.89,Sub,,0,0,0,,esporas de una
Dialogue: 0,0:00:09.90,0:00:11.19,Sub,,0,0,0,,bacteria llamada Bacillus
Dialogue: 0,0:00:11.20,0:00:12.01,Sub,,0,0,0,,cereus.
Dialogue: 0,0:00:12.23,0:00:13.07,Sub,,0,0,0,,Vienen del suelo
Dialogue: 0,0:00:13.08,0:00:13.75,Sub,,0,0,0,,y resisten la
Dialogue: 0,0:00:13.76,0:00:14.54,Sub,,0,0,0,,cocción.
Dialogue: 0,0:00:15.03,0:00:15.92,Sub,,0,0,0,,Al cocinar,
Dialogue: 0,0:00:15.93,0:00:16.75,Sub,,0,0,0,,se mueren muchas
Dialogue: 0,0:00:16.76,0:00:17.73,Sub,,0,0,0,,bacterias.
Dialogue: 0,0:00:17.95,0:00:18.72,Sub,,0,0,0,,Pero las esporas
Dialogue: 0,0:00:18.73,0:00:19.58,Sub,,0,0,0,,de Bacillus cereus
Dialogue: 0,0:00:19.59,0:00:20.56,Sub,,0,0,0,,sobreviven al hervor
Dialogue: 0,0:00:20.57,0:00:21.40,Sub,,0,0,0,,y quedan listas
Dialogue: 0,0:00:21.41,0:00:22.54,Sub,,0,0,0,,para despertar.
Dialogue: 0,0:00:23.02,0:00:23.67,Sub,,0,0,0,,Si el arroz
Dialogue: 0,0:00:23.68,0:00:24.12,Sub,,0,0,0,,se queda a
Dialogue: 0,0:00:24.13,0:00:25.48,Sub,,0,0,0,,temperatura ambiente,
Dialogue: 0,0:00:25.49,0:00:26.54,Sub,,0,0,0,,las esporas germinan
Dialogue: 0,0:00:26.55,0:00:27.19,Sub,,0,0,0,,y la bacteria
Dialogue: 0,0:00:27.20,0:00:28.29,Sub,,0,0,0,,se multiplica.
Dialogue: 0,0:00:28.51,0:00:29.43,Sub,,0,0,0,,Ahí produce una
Dialogue: 0,0:00:29.44,0:00:31.22,Sub,,0,0,0,,toxina llamada cereulida.
Dialogue: 0,0:00:31.70,0:00:32.62,Sub,,0,0,0,,Esa toxina ya
Dialogue: 0,0:00:32.63,0:00:33.13,Sub,,0,0,0,,está en el
Dialogue: 0,0:00:33.14,0:00:33.88,Sub,,0,0,0,,arroz antes de
Dialogue: 0,0:00:33.89,0:00:34.66,Sub,,0,0,0,,comerlo.
Dialogue: 0,0:00:34.88,0:00:36.13,Sub,,0,0,0,,Resiste el sartén,
Dialogue: 0,0:00:36.14,0:00:36.68,Sub,,0,0,0,,el horno y
Dialogue: 0,0:00:36.69,0:00:37.79,Sub,,0,0,0,,el microondas:
Dialogue: 0,0:00:37.94,0:00:38.86,Sub,,0,0,0,,recalentar no la
Dialogue: 0,0:00:38.87,0:00:39.71,Sub,,0,0,0,,destruye.
Dialogue: 0,0:00:40.20,0:00:41.33,Sub,,0,0,0,,Puede provocar náusea
Dialogue: 0,0:00:41.34,0:00:41.89,Sub,,0,0,0,,y vómito en
Dialogue: 0,0:00:41.90,0:00:42.61,Sub,,0,0,0,,menos de seis
Dialogue: 0,0:00:42.62,0:00:43.32,Sub,,0,0,0,,horas.
Dialogue: 0,0:00:43.54,0:00:44.31,Sub,,0,0,0,,Suele pasar en
Dialogue: 0,0:00:44.32,0:00:45.01,Sub,,0,0,0,,un día,
Dialogue: 0,0:00:45.02,0:00:45.75,Sub,,0,0,0,,pero el malestar
Dialogue: 0,0:00:45.76,0:00:46.53,Sub,,0,0,0,,es real.
Dialogue: 0,0:00:47.01,0:00:47.61,Sub,,0,0,0,,En el Reino
Dialogue: 0,0:00:47.62,0:00:48.31,Sub,,0,0,0,,Unido,
Dialogue: 0,0:00:48.32,0:00:48.88,Sub,,0,0,0,,la agencia de
Dialogue: 0,0:00:48.89,0:00:50.28,Sub,,0,0,0,,alimentos recomienda enfriarlo
Dialogue: 0,0:00:50.29,0:00:51.04,Sub,,0,0,0,,de preferencia en
Dialogue: 0,0:00:51.05,0:00:51.79,Sub,,0,0,0,,una hora,
Dialogue: 0,0:00:51.80,0:00:52.48,Sub,,0,0,0,,y no dejarlo
Dialogue: 0,0:00:52.49,0:00:53.30,Sub,,0,0,0,,en la olla.
Dialogue: 0,0:00:53.80,0:00:54.45,Sub,,0,0,0,,Guárdalo en el
Dialogue: 0,0:00:54.46,0:00:55.58,Sub,,0,0,0,,refrigerador y cómelo
Dialogue: 0,0:00:55.59,0:00:56.30,Sub,,0,0,0,,en las siguientes
Dialogue: 0,0:00:56.31,0:00:57.68,Sub,,0,0,0,,24 horas.
Dialogue: 0,0:00:57.90,0:00:59.15,Sub,,0,0,0,,Si lo recalientas,
Dialogue: 0,0:00:59.16,0:00:59.95,Sub,,0,0,0,,que quede humeante
Dialogue: 0,0:00:59.96,0:01:00.88,Sub,,0,0,0,,por completo,
Dialogue: 0,0:01:00.89,0:01:01.51,Sub,,0,0,0,,y solo una
Dialogue: 0,0:01:01.52,0:01:02.20,Sub,,0,0,0,,vez.
Dialogue: 0,0:01:02.68,0:01:03.22,Sub,,0,0,0,,El arroz de
Dialogue: 0,0:01:03.23,0:01:03.77,Sub,,0,0,0,,ayer sí se
Dialogue: 0,0:01:03.78,0:01:04.62,Sub,,0,0,0,,puede comer,
Dialogue: 0,0:01:04.63,0:01:05.19,Sub,,0,0,0,,si se enfrió
Dialogue: 0,0:01:05.20,0:01:05.80,Sub,,0,0,0,,pronto y se
Dialogue: 0,0:01:05.81,0:01:06.92,Sub,,0,0,0,,guardó en frío.
Dialogue: 0,0:01:07.14,0:01:07.82,Sub,,0,0,0,,El dato no
Dialogue: 0,0:01:07.83,0:01:08.98,Sub,,0,0,0,,es para asustar:
Dialogue: 0,0:01:09.13,0:01:09.68,Sub,,0,0,0,,es para no
Dialogue: 0,0:01:09.69,0:01:10.31,Sub,,0,0,0,,olvidarlo en la
Dialogue: 0,0:01:10.32,0:01:11.10,Sub,,0,0,0,,estufa.
Dialogue: 0,0:01:11.32,0:01:12.16,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:12.17,0:01:13.32,Sub,,0,0,0,,y ociosidades.
