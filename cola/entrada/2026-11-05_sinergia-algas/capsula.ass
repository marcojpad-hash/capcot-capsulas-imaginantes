Dialogue: 0,0:00:00.30,0:00:00.82,Sub,,0,0,0,,Un bloom de
Dialogue: 0,0:00:00.83,0:00:01.62,Sub,,0,0,0,,algas que cubre
Dialogue: 0,0:00:01.63,0:00:02.51,Sub,,0,0,0,,kilómetros de mar
Dialogue: 0,0:00:02.52,0:00:03.19,Sub,,0,0,0,,se desploma de
Dialogue: 0,0:00:03.20,0:00:03.91,Sub,,0,0,0,,golpe.
Dialogue: 0,0:00:04.13,0:00:05.03,Sub,,0,0,0,,Y los virus,
Dialogue: 0,0:00:05.04,0:00:05.96,Sub,,0,0,0,,por sí solos,
Dialogue: 0,0:00:05.97,0:00:06.71,Sub,,0,0,0,,no alcanzan a
Dialogue: 0,0:00:06.72,0:00:07.70,Sub,,0,0,0,,explicarlo.
Dialogue: 0,0:00:08.19,0:00:09.88,Sub,,0,0,0,,Es Gephyrocapsa huxleyi,
Dialogue: 0,0:00:09.90,0:00:10.98,Sub,,0,0,0,,un cocolitóforo muy
Dialogue: 0,0:00:10.99,0:00:11.90,Sub,,0,0,0,,abundante.
Dialogue: 0,0:00:12.12,0:00:12.76,Sub,,0,0,0,,Cuando su bloom
Dialogue: 0,0:00:12.77,0:00:13.58,Sub,,0,0,0,,colapsa,
Dialogue: 0,0:00:13.60,0:00:14.37,Sub,,0,0,0,,menos del 30
Dialogue: 0,0:00:14.38,0:00:14.98,Sub,,0,0,0,,por ciento de
Dialogue: 0,0:00:14.99,0:00:15.83,Sub,,0,0,0,,las células tiene
Dialogue: 0,0:00:15.84,0:00:17.41,Sub,,0,0,0,,infección viral activa.
Dialogue: 0,0:00:17.88,0:00:18.53,Sub,,0,0,0,,Un equipo del
Dialogue: 0,0:00:18.54,0:00:19.72,Sub,,0,0,0,,Instituto Weizmann,
Dialogue: 0,0:00:19.73,0:00:20.61,Sub,,0,0,0,,en Israel,
Dialogue: 0,0:00:20.62,0:00:21.60,Sub,,0,0,0,,armó una comunidad
Dialogue: 0,0:00:21.61,0:00:23.11,Sub,,0,0,0,,sintética con algas,
Dialogue: 0,0:00:23.12,0:00:24.08,Sub,,0,0,0,,virus y bacterias
Dialogue: 0,0:00:24.09,0:00:24.87,Sub,,0,0,0,,aislados de un
Dialogue: 0,0:00:24.88,0:00:25.81,Sub,,0,0,0,,bloom real.
Dialogue: 0,0:00:26.31,0:00:27.28,Sub,,0,0,0,,Resultado:
Dialogue: 0,0:00:27.43,0:00:28.68,Sub,,0,0,0,,las bacterias aumentaron
Dialogue: 0,0:00:28.69,0:00:30.20,Sub,,0,0,0,,significativamente la muerte
Dialogue: 0,0:00:30.21,0:00:31.11,Sub,,0,0,0,,de algas causada
Dialogue: 0,0:00:31.12,0:00:32.14,Sub,,0,0,0,,por el virus.
Dialogue: 0,0:00:32.36,0:00:32.91,Sub,,0,0,0,,No era un
Dialogue: 0,0:00:32.92,0:00:33.55,Sub,,0,0,0,,ataque,
Dialogue: 0,0:00:33.56,0:00:35.03,Sub,,0,0,0,,sino una coinfección.
Dialogue: 0,0:00:35.52,0:00:36.62,Sub,,0,0,0,,Para medirlo crearon
Dialogue: 0,0:00:36.63,0:00:37.75,Sub,,0,0,0,,dos índices:
Dialogue: 0,0:00:37.90,0:00:39.00,Sub,,0,0,0,,el de sinergia,
Dialogue: 0,0:00:39.01,0:00:39.50,Sub,,0,0,0,,que mide la
Dialogue: 0,0:00:39.51,0:00:40.21,Sub,,0,0,0,,fuerza de esa
Dialogue: 0,0:00:40.22,0:00:40.95,Sub,,0,0,0,,alianza,
Dialogue: 0,0:00:40.96,0:00:41.27,Sub,,0,0,0,,y el de
Dialogue: 0,0:00:41.28,0:00:42.12,Sub,,0,0,0,,beneficio,
Dialogue: 0,0:00:42.13,0:00:42.86,Sub,,0,0,0,,que mide cuánto
Dialogue: 0,0:00:42.87,0:00:44.11,Sub,,0,0,0,,gana la bacteria.
Dialogue: 0,0:00:44.59,0:00:45.41,Sub,,0,0,0,,La campeona fue
Dialogue: 0,0:00:45.42,0:00:46.49,Sub,,0,0,0,,Alteromonas:
Dialogue: 0,0:00:46.64,0:00:47.69,Sub,,0,0,0,,la atraen extractos
Dialogue: 0,0:00:47.70,0:00:49.06,Sub,,0,0,0,,de células infectadas,
Dialogue: 0,0:00:49.07,0:00:49.71,Sub,,0,0,0,,se acumula en
Dialogue: 0,0:00:49.72,0:00:50.31,Sub,,0,0,0,,los restos del
Dialogue: 0,0:00:50.32,0:00:51.36,Sub,,0,0,0,,colapso y aumenta
Dialogue: 0,0:00:51.37,0:00:51.98,Sub,,0,0,0,,cuando el bloom
Dialogue: 0,0:00:51.99,0:00:52.79,Sub,,0,0,0,,cae.
Dialogue: 0,0:00:53.28,0:00:53.73,Sub,,0,0,0,,Y no es
Dialogue: 0,0:00:53.74,0:00:54.92,Sub,,0,0,0,,un caso aislado:
Dialogue: 0,0:00:55.07,0:00:56.08,Sub,,0,0,0,,la sinergia también
Dialogue: 0,0:00:56.09,0:00:56.90,Sub,,0,0,0,,apareció en otras
Dialogue: 0,0:00:56.91,0:00:57.98,Sub,,0,0,0,,tres microalgas muy
Dialogue: 0,0:00:57.99,0:00:58.89,Sub,,0,0,0,,extendidas por el
Dialogue: 0,0:00:58.90,0:00:59.68,Sub,,0,0,0,,planeta.
Dialogue: 0,0:01:00.16,0:01:00.95,Sub,,0,0,0,,Importa por el
Dialogue: 0,0:01:00.96,0:01:01.77,Sub,,0,0,0,,carbono.
Dialogue: 0,0:01:01.99,0:01:03.66,Sub,,0,0,0,,Los organismos fotosintéticos
Dialogue: 0,0:01:03.67,0:01:04.36,Sub,,0,0,0,,del mar fijan
Dialogue: 0,0:01:04.37,0:01:05.60,Sub,,0,0,0,,unos 50 gigatones
Dialogue: 0,0:01:05.61,0:01:06.23,Sub,,0,0,0,,de carbono al
Dialogue: 0,0:01:06.24,0:01:06.78,Sub,,0,0,0,,año,
Dialogue: 0,0:01:06.79,0:01:07.46,Sub,,0,0,0,,y buena parte
Dialogue: 0,0:01:07.47,0:01:08.25,Sub,,0,0,0,,ocurre en blooms
Dialogue: 0,0:01:08.26,0:01:09.16,Sub,,0,0,0,,como este.
Dialogue: 0,0:01:09.64,0:01:10.74,Sub,,0,0,0,,Esta alianza decide
Dialogue: 0,0:01:10.75,0:01:11.57,Sub,,0,0,0,,si ese carbono
