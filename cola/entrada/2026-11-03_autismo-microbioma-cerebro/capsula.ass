Dialogue: 0,0:00:00.30,0:00:00.68,Sub,,0,0,0,,¿Y si el
Dialogue: 0,0:00:00.69,0:00:01.42,Sub,,0,0,0,,intestino de un
Dialogue: 0,0:00:01.43,0:00:02.34,Sub,,0,0,0,,niño con autismo
Dialogue: 0,0:00:02.35,0:00:03.30,Sub,,0,0,0,,le mandara señales
Dialogue: 0,0:00:03.31,0:00:04.72,Sub,,0,0,0,,distintas al cerebro?
Dialogue: 0,0:00:04.97,0:00:06.15,Sub,,0,0,0,,UCLA y USC
Dialogue: 0,0:00:06.16,0:00:07.93,Sub,,0,0,0,,buscaron esa conversación.
Dialogue: 0,0:00:08.43,0:00:10.29,Sub,,0,0,0,,Participaron 84 niños
Dialogue: 0,0:00:10.30,0:00:11.15,Sub,,0,0,0,,y adolescentes de
Dialogue: 0,0:00:11.16,0:00:12.13,Sub,,0,0,0,,8 a 17
Dialogue: 0,0:00:12.14,0:00:12.91,Sub,,0,0,0,,años.
Dialogue: 0,0:00:13.13,0:00:13.95,Sub,,0,0,0,,La mitad tenía
Dialogue: 0,0:00:13.96,0:00:15.51,Sub,,0,0,0,,diagnóstico de autismo;
Dialogue: 0,0:00:15.66,0:00:16.74,Sub,,0,0,0,,la otra mitad,
Dialogue: 0,0:00:16.75,0:00:17.33,Sub,,0,0,0,,no.
Dialogue: 0,0:00:17.81,0:00:18.74,Sub,,0,0,0,,El equipo analizó
Dialogue: 0,0:00:18.75,0:00:19.92,Sub,,0,0,0,,muestras de heces,
Dialogue: 0,0:00:19.93,0:00:20.87,Sub,,0,0,0,,escaneó el cerebro
Dialogue: 0,0:00:20.88,0:00:22.01,Sub,,0,0,0,,de cada participante
Dialogue: 0,0:00:22.02,0:00:22.59,Sub,,0,0,0,,y midió su
Dialogue: 0,0:00:22.60,0:00:23.46,Sub,,0,0,0,,conducta.
Dialogue: 0,0:00:23.95,0:00:24.52,Sub,,0,0,0,,En el grupo
Dialogue: 0,0:00:24.53,0:00:25.68,Sub,,0,0,0,,con autismo encontraron
Dialogue: 0,0:00:25.69,0:00:26.78,Sub,,0,0,0,,menos metabolitos que
Dialogue: 0,0:00:26.79,0:00:27.87,Sub,,0,0,0,,fabrican los microbios
Dialogue: 0,0:00:27.88,0:00:28.46,Sub,,0,0,0,,a partir del
Dialogue: 0,0:00:28.47,0:00:29.38,Sub,,0,0,0,,triptófano,
Dialogue: 0,0:00:29.39,0:00:30.22,Sub,,0,0,0,,un aminoácido que
Dialogue: 0,0:00:30.23,0:00:30.79,Sub,,0,0,0,,llega con la
Dialogue: 0,0:00:30.80,0:00:31.57,Sub,,0,0,0,,comida.
Dialogue: 0,0:00:32.06,0:00:33.13,Sub,,0,0,0,,Uno destacó:
Dialogue: 0,0:00:33.28,0:00:34.41,Sub,,0,0,0,,el kynurenato,
Dialogue: 0,0:00:34.42,0:00:34.85,Sub,,0,0,0,,de la vía
Dialogue: 0,0:00:34.86,0:00:36.10,Sub,,0,0,0,,de la kinurenina.
Dialogue: 0,0:00:36.32,0:00:37.00,Sub,,0,0,0,,Esa vía está
Dialogue: 0,0:00:37.01,0:00:38.15,Sub,,0,0,0,,ligada al procesamiento
Dialogue: 0,0:00:38.16,0:00:38.82,Sub,,0,0,0,,cerebral y a
Dialogue: 0,0:00:38.83,0:00:40.28,Sub,,0,0,0,,cambios cognitivos.
Dialogue: 0,0:00:40.77,0:00:41.62,Sub,,0,0,0,,Los niveles más
Dialogue: 0,0:00:41.63,0:00:42.49,Sub,,0,0,0,,bajos se asociaron
Dialogue: 0,0:00:42.50,0:00:43.17,Sub,,0,0,0,,con cambios en
Dialogue: 0,0:00:43.18,0:00:43.79,Sub,,0,0,0,,la actividad de
Dialogue: 0,0:00:43.80,0:00:44.36,Sub,,0,0,0,,la ínsula y
Dialogue: 0,0:00:44.37,0:00:45.25,Sub,,0,0,0,,del cíngulo,
Dialogue: 0,0:00:45.26,0:00:46.14,Sub,,0,0,0,,zonas ligadas a
Dialogue: 0,0:00:46.15,0:00:46.98,Sub,,0,0,0,,las emociones y
Dialogue: 0,0:00:46.99,0:00:47.81,Sub,,0,0,0,,al cuerpo.
Dialogue: 0,0:00:48.31,0:00:49.05,Sub,,0,0,0,,Y mientras más
Dialogue: 0,0:00:49.06,0:00:49.69,Sub,,0,0,0,,bajos,
Dialogue: 0,0:00:49.70,0:00:50.42,Sub,,0,0,0,,más severos los
Dialogue: 0,0:00:50.43,0:00:51.34,Sub,,0,0,0,,síntomas.
Dialogue: 0,0:00:51.56,0:00:52.27,Sub,,0,0,0,,Ojo:
Dialogue: 0,0:00:52.42,0:00:53.08,Sub,,0,0,0,,no prueba que
Dialogue: 0,0:00:53.09,0:00:54.36,Sub,,0,0,0,,esos metabolitos causen
Dialogue: 0,0:00:54.37,0:00:55.17,Sub,,0,0,0,,el cambio;
Dialogue: 0,0:00:55.32,0:00:56.06,Sub,,0,0,0,,apunta a un
Dialogue: 0,0:00:56.07,0:00:56.87,Sub,,0,0,0,,vínculo.
Dialogue: 0,0:00:57.35,0:00:58.43,Sub,,0,0,0,,Los autores proponen
Dialogue: 0,0:00:58.44,0:00:59.63,Sub,,0,0,0,,investigar dietas,
Dialogue: 0,0:00:59.64,0:01:01.47,Sub,,0,0,0,,probióticos o simbióticos.
Dialogue: 0,0:01:01.69,0:01:02.58,Sub,,0,0,0,,Pero muchos niños
Dialogue: 0,0:01:02.59,0:01:03.53,Sub,,0,0,0,,con autismo tienen
Dialogue: 0,0:01:03.54,0:01:05.09,Sub,,0,0,0,,sensibilidades sensoriales que
Dialogue: 0,0:01:05.10,0:01:05.76,Sub,,0,0,0,,limitan lo que
Dialogue: 0,0:01:05.77,0:01:06.47,Sub,,0,0,0,,comen.
Dialogue: 0,0:01:06.95,0:01:07.55,Sub,,0,0,0,,Fue el primer
Dialogue: 0,0:01:07.56,0:01:08.60,Sub,,0,0,0,,análisis integral de
Dialogue: 0,0:01:08.61,0:01:09.30,Sub,,0,0,0,,cerebro,
Dialogue: 0,0:01:09.31,0:01:10.53,Sub,,0,0,0,,intestino y microbioma
Dialogue: 0,0:01:10.54,0:01:11.45,Sub,,0,0,0,,en autismo.
Dialogue: 0,0:01:11.67,0:01:12.37,Sub,,0,0,0,,¿Hasta dónde los
Dialogue: 0,0:01:12.38,0:01:13.50,Sub,,0,0,0,,microbios moldean cómo
Dialogue: 0,0:01:13.51,0:01:14.40,Sub,,0,0,0,,el cerebro procesa
Dialogue: 0,0:01:14.41,0:01:15.18,Sub,,0,0,0,,el mundo?
Dialogue: 0,0:01:15.43,0:01:16.27,Sub,,0,0,0,,Esto fue Datos
Dialogue: 0,0:01:16.28,0:01:17.43,Sub,,0,0,0,,y ociosidades.
